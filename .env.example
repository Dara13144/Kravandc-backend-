# ==============================================================================
# KV DIGITAL CINEMA - ENVIRONMENT VARIABLES CONFIGURATION (.env)
# ==============================================================================

# Server Configuration
PORT=5050
NODE_ENV=production

# ==============================================================================
# SUPABASE DATABASE CONFIGURATION (PostgreSQL)
# ==============================================================================
# Supabase Transaction Pooler URL (Port 6543 - for high performance API queries)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct Connection URL (Port 5432 - for Prisma Migrations)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase API & Storage Configuration (Optional for cloud storage bucket)
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="kv-media"

# JWT Authentication Secrets
JWT_SECRET="replace_with_a_secure_jwt_secret_key_at_least_32_characters"
JWT_REFRESH_SECRET="replace_with_a_secure_jwt_refresh_secret_key"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

